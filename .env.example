# Copy to .env.local and fill in. .env.local is gitignored and must stay that way.
# Values for dev come from the Supabase project "hackathon-base-dev".

# ---------------------------------------------------------------------------
# Public. These are inlined into the browser bundle. Never put a secret here.
# ---------------------------------------------------------------------------

# Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The publishable (anon) key. Safe to expose: it is only as powerful as your
# RLS policies, which is exactly why every table has them.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Origin this app is served from. Used to build auth redirect URLs.
# Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Server-only. Never prefix any of these with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Service role key. Bypasses RLS completely. Server routes, actions and
# scripts only. `pnpm check:leak` fails the build if it reaches the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string, for `pnpm check:rls`.
# This is NOT the project URL. It must start with postgresql:// and carry the
# database password:
#   postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# Project Settings -> Database -> Connection string -> URI.
# Optional: SUPABASE_ACCESS_TOKEN below covers check:rls on its own.
SUPABASE_DB_URL=

# Supabase project ref, used by `pnpm types`. e.g. iaewhpzyskptgvbvlssc
SUPABASE_PROJECT_REF=

# Personal access token. Used by `pnpm types`, and by `pnpm check:rls` when
# SUPABASE_DB_URL is not set. Easier to obtain and rotate than the database
# password, so prefer this. Create at
# https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Optional. Absent is fine; the app degrades sensibly.
# ---------------------------------------------------------------------------

# Distributed rate limiting. Without these the limiter is per-process memory,
# which does not hold across Vercel instances. Set both before relying on it.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set to "true" to enforce the CSP instead of only reporting violations.
CSP_ENFORCE=
